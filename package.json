{
  "name": "waterfall",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "lint": "npm --prefix web run lint",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:new": "npx supabase migration new",
    "db:test": "npx supabase test db",
    "mcp:check": "biome check mcp/src",
    "mcp:format": "biome format --write mcp/src",
    "mcp:lint": "biome lint mcp/src",
    "mcp:login": "node --env-file=mcp/.env --import tsx mcp/src/login.ts",
    "mcp:dev": "node --env-file=mcp/.env --import tsx mcp/src/index.ts",
    "mcp:test": "vitest run --config mcp/vitest.config.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^24.0.0",
    "supabase": "^2.115.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  }
}
